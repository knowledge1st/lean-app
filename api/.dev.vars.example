# Copy to .dev.vars and fill in. In local dev ALLOWED_ORIGIN is http://localhost:5173.
DATABASE_URL=
ALLOWED_ORIGIN=

# Opcional: key de OpenRouter para interpretar comidas con modelos gratuitos.
OPENROUTER_API_KEY=

# Opcional: notificaciones push. Generar con `node scripts/generate-vapid-keys.ts`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
APP_URL=http://localhost:5173/
